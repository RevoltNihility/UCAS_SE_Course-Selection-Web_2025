<div class="course-students-page">
  <h1><%= @course.name %> - 学生名单</h1>

  <div class="back-link">
    <%= link_to "← 返回课程列表", teacher_courses_teaching_courses_path, class: "btn btn-secondary" %>
  </div>

  <div class="course-info">
    <p><strong>课程编号：</strong><%= @course.code %></p>
    <p><strong>学分：</strong><%= @course.credits %></p>
    <p><strong>上课时间：</strong><%= @course.formatted_schedule %></p>
  </div>

  <div class="students-table-wrapper">
    <% if @students.empty? %>
      <div class="empty-state">
        <p>暂无学生选课</p>
      </div>
    <% else %>
      <table class="students-table">
        <thead>
          <tr>
            <th>学号</th>
            <th>姓名</th>
            <th>邮箱</th>
          </tr>
        </thead>
        <tbody>
          <% @students.each do |student| %>
            <tr>
              <td><%= student.student_id %></td>
              <td><%= student.name %></td>
              <td><%= student.email %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <div class="student-count">
        <p>共 <%= @students.count %> 名学生</p>
      </div>
    <% end %>
  </div>
</div>

<style>
  .course-students-page {
    max-width: 1200px;
    margin: 20px auto;
    padding: 0 20px;
  }

  .course-students-page h1 {
    font-size: 24px;
    margin-bottom: 20px;
    border-bottom: 2px solid #333;
    padding-bottom: 10px;
  }

  .back-link {
    margin-bottom: 20px;
  }

  .course-info {
    background: #f5f5f5;
    border: 1px solid #ddd;
    padding: 15px;
    margin-bottom: 20px;
  }

  .course-info p {
    margin: 5px 0;
    font-size: 14px;
  }

  .students-table-wrapper {
    overflow-x: auto;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: #f9f9f9;
    border: 1px solid #ddd;
  }

  .empty-state p {
    font-size: 16px;
    color: #666;
    margin: 0;
  }

  .students-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #ddd;
  }

  .students-table th,
  .students-table td {
    padding: 10px;
    text-align: left;
    border: 1px solid #ddd;
  }

  .students-table th {
    background: #f5f5f5;
    font-weight: bold;
  }

  .students-table tbody tr:hover {
    background: #fafafa;
  }

  .student-count {
    margin-top: 15px;
    text-align: right;
    font-size: 14px;
    color: #666;
  }

  .btn {
    padding: 8px 16px;
    border: 1px solid #333;
    background: #fff;
    cursor: pointer;
    font-size: 14px;
    text-decoration: none;
    display: inline-block;
  }

  .btn:hover:not(:disabled) {
    background: #f0f0f0;
  }

  .btn-secondary {
    background: #fff;
    color: #333;
  }
</style>
