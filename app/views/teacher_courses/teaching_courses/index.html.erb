<div class="teacher-courses-page">
  <div class="page-header">
    <h1>我教授的课程</h1>
    <%= button_to "退出登录", logout_path, method: :delete, class: "btn btn-logout", data: { turbo: false } %>
  </div>

  <div class="courses-table-wrapper">
    <% if @courses.empty? %>
      <div class="empty-state">
        <p>暂无教授课程</p>
      </div>
    <% else %>
      <table class="courses-table">
        <thead>
          <tr>
            <th>课程编号</th>
            <th>课程名称</th>
            <th>学时/学分</th>
            <th>课程类型</th>
            <th>上课时间</th>
            <th>学期</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @courses.each do |course| %>
            <% teaching = course.teachings.find { |t| t.teacher_id == @teacher.id } %>
            <tr>
              <td><%= course.code %></td>
              <td><%= course.name %></td>
              <td><%= course.class_hours %>/<%= course.credits %></td>
              <td><%= course.course_type_i18n %></td>
              <td><%= course.formatted_schedule %></td>
              <td><%= teaching&.semester || "未设置" %></td>
              <td>
                <%= link_to "查看学生", teacher_courses_course_student_path(course), class: "btn btn-primary btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>

<style>
  .teacher-courses-page {
    max-width: 1400px;
    margin: 20px auto;
    padding: 0 20px;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    border-bottom: 2px solid #333;
    padding-bottom: 10px;
  }

  .teacher-courses-page h1 {
    font-size: 24px;
    margin: 0;
  }

  .courses-table-wrapper {
    overflow-x: auto;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: #f9f9f9;
    border: 1px solid #ddd;
  }

  .empty-state p {
    font-size: 16px;
    color: #666;
    margin: 0;
  }

  .courses-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #ddd;
  }

  .courses-table th,
  .courses-table td {
    padding: 10px;
    text-align: left;
    border: 1px solid #ddd;
  }

  .courses-table th {
    background: #f5f5f5;
    font-weight: bold;
  }

  .courses-table tbody tr:hover {
    background: #fafafa;
  }

  .courses-table td:nth-child(7) {
    text-align: center;
  }

  .btn {
    padding: 8px 16px;
    border: 1px solid #333;
    background: #fff;
    cursor: pointer;
    font-size: 14px;
    text-decoration: none;
    display: inline-block;
  }

  .btn:hover:not(:disabled) {
    background: #f0f0f0;
  }

  .btn-primary {
    background: #333;
    color: #fff;
  }

  .btn-primary:hover {
    background: #555;
  }

  .btn-sm {
    padding: 4px 12px;
    font-size: 13px;
  }

  .btn-logout {
    background: #fff;
    color: #d9534f;
    border-color: #d9534f;
  }

  .btn-logout:hover {
    background: #d9534f;
    color: #fff;
  }
</style>
