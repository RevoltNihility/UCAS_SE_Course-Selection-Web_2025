<div class="my-courses-page">
  <h1>已选课程</h1>

  <div class="my-courses-layout">
    <%= render "my_courses/sidebar", current_page: :selected_courses %>

    <div class="my-courses-container">
      <div class="schedule-button-wrapper">
    <button class="btn btn-secondary" disabled>查看本学期课表</button>
  </div>

  <div class="filter-form">
    <%= form_with url: my_courses_selected_courses_path, method: :get, local: true do |f| %>
      <div class="filter-fields">
        <div class="filter-field">
          <%= f.label :semester, "选课学期" %>
          <%= f.select :semester,
                       options_for_select([["不限", ""]] + @available_semesters.map { |s| [s, s] }, params[:semester]),
                       {},
                       { id: "semester-select" } %>
        </div>

        <div class="filter-field">
          <%= f.label :course_name, "课程名称" %>
          <%= f.text_field :course_name, value: params[:course_name], placeholder: "输入课程名称搜索" %>
        </div>
      </div>

      <div class="filter-actions">
        <%= f.submit "查询", name: nil, class: "btn btn-primary" %>
        <button type="button" class="btn btn-secondary" onclick="window.location.href='<%= my_courses_selected_courses_path %>'">重置</button>
      </div>
    <% end %>
  </div>

  <div class="courses-table-wrapper">
    <% if @enrollments.empty? %>
      <div class="empty-state">
        <p>
          <% if params[:semester].present? || params[:course_name].present? %>
            未找到符合条件的课程
          <% else %>
            暂无选课记录
          <% end %>
        </p>
      </div>
    <% else %>
      <table class="courses-table">
        <thead>
          <tr>
            <th>课程编号</th>
            <th>课程名称</th>
            <th>学时/学分</th>
            <th>课程类型</th>
            <th>主讲教师</th>
            <th>选课学期</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @enrollments.each do |enrollment| %>
            <% course = enrollment.course %>
            <tr>
              <td><%= course.code %></td>
              <td><%= course.name %></td>
              <td><%= format_class_hours_credits(course) %></td>
              <td><%= enrollment.course_type_i18n %></td>
              <td><%= course.teacher %></td>
              <td><%= enrollment.semester_display %></td>
              <td>
                <%= button_to "退课", my_courses_selected_course_path(enrollment.id),
                    method: :delete,
                    class: "btn btn-danger btn-sm",
                    data: { confirm: "确定要退选该课程吗？" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
</div>

<style>
  .my-courses-page {
    max-width: 1400px;
    margin: 20px auto;
    padding: 0 20px;
  }

  .my-courses-page h1 {
    font-size: 24px;
    margin-bottom: 20px;
    border-bottom: 2px solid #333;
    padding-bottom: 10px;
  }

  .my-courses-layout {
    display: flex;
    gap: 20px;
  }

  .my-courses-sidebar {
    flex-shrink: 0;
    width: 200px;
  }

  .sidebar-nav {
    background: #f5f5f5;
    border: 1px solid #ddd;
  }

  .sidebar-item {
    display: block;
    padding: 12px 16px;
    border-bottom: 1px solid #ddd;
    text-decoration: none;
    color: #333;
    font-size: 14px;
    cursor: pointer;
  }

  .sidebar-item:last-child {
    border-bottom: none;
  }

  .sidebar-item:hover:not(.disabled) {
    background: #e8e8e8;
  }

  .sidebar-item.active {
    background: #333;
    color: #fff;
    font-weight: bold;
  }

  .sidebar-item.disabled {
    color: #999;
    cursor: not-allowed;
  }

  .my-courses-container {
    flex: 1;
    min-width: 0;
  }

  .filter-form {
    background: #f5f5f5;
    border: 1px solid #ddd;
    padding: 15px;
    margin-bottom: 20px;
  }

  .filter-fields {
    display: flex;
    gap: 15px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  .filter-field {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .filter-field label {
    font-weight: bold;
    font-size: 14px;
  }

  .filter-field select,
  .filter-field input[type="text"] {
    padding: 6px 10px;
    border: 1px solid #999;
    font-size: 14px;
    min-width: 200px;
  }

  .filter-actions {
    display: flex;
    gap: 10px;
  }

  .btn {
    padding: 8px 16px;
    border: 1px solid #333;
    background: #fff;
    cursor: pointer;
    font-size: 14px;
  }

  .btn:hover:not(:disabled) {
    background: #f0f0f0;
  }

  .btn-primary {
    background: #333;
    color: #fff;
  }

  .btn-primary:hover {
    background: #555;
  }

  .btn-secondary {
    background: #fff;
    color: #333;
  }

  .btn-danger {
    background: #ddd;
    color: #999;
    border-color: #ccc;
  }

  .btn-sm {
    padding: 4px 12px;
    font-size: 13px;
  }

  .courses-table-wrapper {
    overflow-x: auto;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: #f9f9f9;
    border: 1px solid #ddd;
  }

  .empty-state p {
    font-size: 16px;
    color: #666;
    margin: 0;
  }

  .courses-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #ddd;
  }

  .courses-table th,
  .courses-table td {
    padding: 10px;
    text-align: left;
    border: 1px solid #ddd;
  }

  .courses-table th {
    background: #f5f5f5;
    font-weight: bold;
  }

  .courses-table tbody tr:hover {
    background: #fafafa;
  }

  .courses-table td:nth-child(7) {
    text-align: center;
  }

  .schedule-button-wrapper {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 20px;
  }
</style>
